{
  "name": "study-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Track progress on the Power BI 100-day roadmap and the Sales & Marketing case study plan.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
