# Port the server listens on (most hosts set this for you)
PORT=3000

# Postgres connection string (e.g. from Neon). When set, Postgres is used instead of SQLite.
DATABASE_URL=

# Folder where the SQLite database is stored (used only when DATABASE_URL is empty). Point it at a persistent volume in production.
DATA_DIR=./data

# Secret used to sign login sessions. Optional: if unset, one is generated and stored in the database.
JWT_SECRET=

# Optional: this email is always an admin. If ADMIN_PASSWORD is also set, the account is created on boot.
# (Without these, the first account that registers becomes the admin.)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
